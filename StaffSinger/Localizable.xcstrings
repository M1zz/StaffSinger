    "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: large text layouts",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大文字时，界面会重新排布，不会被截断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大文字時，畫面會重新排版，不會被截斷。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字を大きくしても切れず、見やすく配置し直されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При увеличении шрифта экраны перестраиваются, ничего не обрезается."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al agrandar el texto, las pantallas se reorganizan en lugar de cortarse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei größerer Schrift ordnen sich die Bildschirme neu an, statt abgeschnitten zu werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous agrandissez le texte, les écrans se réorganisent au lieu d’être coupés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ingrandisci il testo, le schermate si riorganizzano invece di essere tagliate."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao aumentar o texto, as telas se reorganizam em vez de serem cortadas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อขยายขนาดตัวอักษร หน้าจอจะจัดเรียงใหม่แทนที่จะถูกตัด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi phóng to chữ, màn hình tự sắp xếp lại thay vì bị cắt mất."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při zvětšení písma se obrazovky přeskládají, místo aby se ořízly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du gør teksten større, ordnes skærmene om, så intet bliver skåret af."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν μεγαλώνετε το κείμενο, οι οθόνες αναδιατάσσονται αντί να κόβονται."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun suurennat tekstiä, näytöt järjestyvät uudelleen eivätkä leikkaudu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat teks diperbesar, layar ditata ulang agar tidak terpotong."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du gjør teksten større, ordnes skjermene om i stedet for å bli kuttet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je de tekst vergroot, schikken de schermen zich opnieuw in plaats van af te kappen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy powiększysz tekst, ekrany układają się na nowo, zamiast być przycinane."
          }
        }
      }
    },
    "기기 안에서 처리하는 한국어 음성 인식이 준비되지 않았습니다.\n설정 ▸ 일반 ▸ 키보드 ▸ 받아쓰기에서 한국어를 켜면 필요한 파일이 내려받아집니다." : {
      "comment" : "Dictation error",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 안에서 처리하는 한국어 음성 인식이 준비되지 않았습니다.\n설정 ▸ 일반 ▸ 키보드 ▸ 받아쓰기에서 한국어를 켜면 필요한 파일이 내려받아집니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On-device Korean speech recognition isn't ready.\nTurn on Korean under Settings ▸ General ▸ Keyboard ▸ Dictation to download what's needed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On-device Korean speech recognition isn't ready.\nTurn on Korean under Settings ▸ General ▸ Keyboard ▸ Dictation to download what's needed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备端韩语语音识别尚未就绪。\n请在“设置 ▸ 通用 ▸ 键盘 ▸ 听写”中打开韩语，系统会下载所需文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裝置上的韓語語音辨識尚未準備好。\n請在「設定 ▸ 一般 ▸ 鍵盤 ▸ 聽寫」中開啟韓語，系統就會下載所需檔案。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末内で処理する韓国語の音声認識の準備ができていません。\n「設定 ▸ 一般 ▸ キーボード ▸ 音声入力」で韓国語をオンにすると、必要なファイルがダウンロードされます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознавание корейской речи на устройстве не готово.\nВключите корейский в «Настройки ▸ Основные ▸ Клавиатура ▸ Диктовка» — нужные файлы загрузятся."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de voz en coreano en el dispositivo no está listo.\nActiva el coreano en Ajustes ▸ General ▸ Teclado ▸ Dictado para que se descarguen los archivos necesarios."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spracherkennung für Koreanisch auf dem Gerät ist nicht bereit.\nSchalte Koreanisch unter Einstellungen ▸ Allgemein ▸ Tastatur ▸ Diktierfunktion ein, dann werden die nötigen Dateien geladen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance vocale en coréen sur l’appareil n’est pas prête.\nActivez le coréen dans Réglages ▸ Général ▸ Clavier ▸ Dictée pour télécharger les fichiers nécessaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riconoscimento vocale in coreano sul dispositivo non è pronto.\nAttiva il coreano in Impostazioni ▸ Generali ▸ Tastiera ▸ Dettatura per scaricare i file necessari."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O reconhecimento de voz em coreano no dispositivo não está pronto.\nAtive o coreano em Ajustes ▸ Geral ▸ Teclado ▸ Ditado para baixar os arquivos necessários."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การรู้จำเสียงภาษาเกาหลีบนอุปกรณ์ยังไม่พร้อม\nเปิดภาษาเกาหลีที่การตั้งค่า ▸ ทั่วไป ▸ คีย์บอร์ด ▸ การป้อนด้วยเสียง เพื่อดาวน์โหลดไฟล์ที่จำเป็น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận dạng giọng nói tiếng Hàn trên thiết bị chưa sẵn sàng.\nBật tiếng Hàn tại Cài đặt ▸ Cài đặt chung ▸ Bàn phím ▸ Đọc chính tả để tải các tệp cần thiết."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznávání korejské řeči v zařízení není připraveno.\nZapněte korejštinu v Nastavení ▸ Obecné ▸ Klávesnice ▸ Diktování a stáhnou se potřebné soubory."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koreansk talegenkendelse på enheden er ikke klar.\nSlå koreansk til under Indstillinger ▸ Generelt ▸ Tastatur ▸ Diktering, så hentes de nødvendige filer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναγνώριση ομιλίας στα κορεατικά στη συσκευή δεν είναι έτοιμη.\nΕνεργοποιήστε τα κορεατικά στις Ρυθμίσεις ▸ Γενικά ▸ Πληκτρολόγιο ▸ Υπαγόρευση για να γίνει λήψη των απαραίτητων αρχείων."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitteella tapahtuva korean puheentunnistus ei ole valmis.\nOta korea käyttöön kohdassa Asetukset ▸ Yleiset ▸ Näppäimistö ▸ Sanelu, niin tarvittavat tiedostot ladataan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengenalan suara bahasa Korea di perangkat belum siap.\nAktifkan bahasa Korea di Pengaturan ▸ Umum ▸ Papan Ketik ▸ Dikte agar file yang diperlukan diunduh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koreansk talegjenkjenning på enheten er ikke klar.\nSlå på koreansk under Innstillinger ▸ Generelt ▸ Tastatur ▸ Diktering, så lastes de nødvendige filene ned."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koreaanse spraakherkenning op het apparaat is niet gereed.\nZet Koreaans aan via Instellingen ▸ Algemeen ▸ Toetsenbord ▸ Dicteren, dan worden de benodigde bestanden gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznawanie mowy po koreańsku na urządzeniu nie jest gotowe.\nWłącz koreański w Ustawienia ▸ Ogólne ▸ Klawiatura ▸ Dyktowanie, a potrzebne pliki zostaną pobrane."
          }
        }
      }
    },

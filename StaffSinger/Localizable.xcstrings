          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось распознать ноты. Лучше всего работают чёткая печать, одна строка и снимок прямо перед нотами."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer la partitura. Funciona mejor con música impresa nítida, una sola línea y una foto de frente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Noten konnten nicht gelesen werden. Am besten klappt es mit sauberem Notendruck, einer einzelnen Zeile und einem Foto von vorn."

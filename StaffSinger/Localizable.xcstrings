    "말한 순서만 씁니다. 길이는 모두 4분음표로 넣고 나중에 고치세요." : {
      "comment" : "Dictation snap explanation (free)",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말한 순서만 씁니다. 길이는 모두 4분음표로 넣고 나중에 고치세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the order you spoke is used. Every note goes in as a quarter note; fix lengths later."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the order you spoke is used. Every note goes in as a quarter note; fix lengths later."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只记录你说话的先后顺序。所有音符都按四分音符写入，之后再修改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只記錄你說話的先後順序。所有音符都以四分音符寫入，之後再修改。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話した順番だけを使います。長さはすべて4分音符で入るので、あとで直してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учитывается только порядок слов. Все ноты ставятся четвертными — длительность поправите позже."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se usa el orden en que hablaste. Todas las notas entran como negras; corrige las duraciones después."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es zählt nur die Reihenfolge, in der du sprichst. Alle Noten werden als Viertel eingefügt; die Längen korrigierst du danach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul l’ordre dans lequel vous parlez est utilisé. Toutes les notes sont des noires ; corrigez les durées ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta solo l’ordine in cui parli. Tutte le note entrano come semiminime; correggi le durate dopo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só a ordem em que você fala é usada. Todas as notas entram como semínimas; corrija as durações depois."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เฉพาะลำดับที่พูดเท่านั้น โน้ตทุกตัวจะเป็นโน้ตตัวดำ แล้วค่อยแก้ความยาวทีหลัง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ dùng thứ tự bạn nói. Mọi nốt đều thành nốt đen; hãy sửa độ dài sau."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použije se jen pořadí, v jakém mluvíte. Všechny noty se vloží jako čtvrťové; délky opravíte později."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun rækkefølgen af det, du siger, bruges. Alle noder bliver til kvartnoder; ret længderne bagefter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται μόνο η σειρά που μιλάτε. Όλες οι νότες μπαίνουν ως τέταρτα· διορθώστε τις διάρκειες μετά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain sanomisjärjestys otetaan huomioon. Kaikki nuotit tulevat neljäsosina; korjaa pituudet jälkeenpäin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya urutan ucapanmu yang dipakai. Semua not masuk sebagai not seperempat; perbaiki panjangnya nanti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare rekkefølgen du sier tonene i, brukes. Alle noter blir firedelsnoter; rett lengdene etterpå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen de volgorde van wat je zegt wordt gebruikt. Alle noten komen erin als kwartnoten; pas de lengtes daarna aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczy się tylko kolejność, w jakiej mówisz. Wszystkie nuty wchodzą jako ćwierćnuty; długości popraw później."
          }
        }
      }
    },
    "말한 시점을 가장 가까운 %@음표 자리로 맞춥니다." : {
      "comment" : "Dictation snap explanation; %@ is a grid like 1/4",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말한 시점을 가장 가까운 %@음표 자리로 맞춥니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snaps each spoken moment to the nearest %@ note position."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snaps each spoken moment to the nearest %@ note position."
          }
        },

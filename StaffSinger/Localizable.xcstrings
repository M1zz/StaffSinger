    "앞 음과 가까운 옥타브를 고릅니다. \"시 도\"가 반음 위로 올라갑니다." : {
      "comment" : "Explanation with Korean syllables in quotes",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞 음과 가까운 옥타브를 고릅니다. \"시 도\"가 반음 위로 올라갑니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picks the octave closest to the previous note, so \"시 도\" rises by a semitone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picks the octave closest to the previous note, so \"시 도\" rises by a semitone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择与前一个音最接近的八度，因此“시 도”会升高半音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇與前一個音最接近的八度，因此「시 도」會升高半音。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直前の音に近いオクターブを選びます。「시 도」は半音上がります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирается октава, ближайшая к предыдущей ноте, поэтому «시 도» поднимается на полутон."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la octava más cercana a la nota anterior, así que «시 도» sube un semitono."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählt die Oktave, die der vorigen Note am nächsten liegt, sodass „시 도“ einen Halbton aufwärts geht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisit l’octave la plus proche de la note précédente : « 시 도 » monte donc d’un demi-ton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sceglie l’ottava più vicina alla nota precedente, quindi «시 도» sale di un semitono."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe a oitava mais próxima da nota anterior, então “시 도” sobe um semitom."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกอ็อกเทฟที่ใกล้กับตัวโน้ตก่อนหน้ามากที่สุด “시 도” จึงขึ้นไปครึ่งเสียง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn quãng tám gần nốt trước nhất, nên “시 도” sẽ lên nửa cung."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybere oktávu nejblíže předchozí notě, takže „시 도“ stoupne o půltón."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælger den oktav, der ligger tættest på forrige node, så “시 도” stiger en halvtone."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέγει την οκτάβα που είναι πιο κοντά στην προηγούμενη νότα, οπότε το «시 도» ανεβαίνει κατά ένα ημιτόνιο."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitsee edellistä nuottia lähimmän oktaavin, joten ”시 도” nousee puolisävelaskeleen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memilih oktaf terdekat dengan not sebelumnya, sehingga “시 도” naik setengah nada."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velger oktaven som ligger nærmest forrige note, så «시 도» går en halvtone opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiest het octaaf dat het dichtst bij de vorige noot ligt, dus „시 도” gaat een halve toon omhoog."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybiera oktawę najbliższą poprzedniej nucie, więc „시 도” idzie o półton w górę."
          }
        }
      }
    },

    "오선을 길게 눌러 음을 고르고 떼면 추가됩니다" : {
      "comment" : "Mode hint",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오선을 길게 눌러 음을 고르고 떼면 추가됩니다"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold the staff to pick a pitch, then release to add it"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold the staff to pick a pitch, then release to add it"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按五线谱选择音高，松开即可添加"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按五線譜選擇音高，放開即可加入"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "五線を長押しして音を選び、指を離すと追加されます"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и удерживайте нотный стан, выберите высоту и отпустите — нота добавится"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el pentagrama para elegir la altura y suelta para añadir la nota"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notensystem gedrückt halten, Tonhöhe wählen und loslassen, um die Note hinzuzufügen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement sur la portée, choisissez la hauteur, puis relâchez pour ajouter la note"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto sul pentagramma, scegli l’altezza e rilascia per aggiungere la nota"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o dedo na pauta, escolha a altura e solte para adicionar a nota"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กดบรรทัดห้าเส้นค้างไว้เพื่อเลือกเสียง แล้วปล่อยเพื่อเพิ่มโน้ต"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn giữ khuông nhạc để chọn cao độ rồi thả ra để thêm nốt"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte pětilinku, vyberte výšku a po uvolnění se nota přidá"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold fingeren på nodelinjerne, vælg tonehøjde, og slip for at tilføje noden"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε παρατεταμένα στο πεντάγραμμο, επιλέξτε ύψος και αφήστε για να προστεθεί η νότα"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä nuottiviivastoa painettuna, valitse korkeus ja nosta sormi lisätäksesi nuotin"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan paranada untuk memilih tinggi nada, lalu lepas untuk menambahkan not"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold inne på notesystemet, velg tonehøyde og slipp for å legge til noten"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de notenbalk ingedrukt, kies een toonhoogte en laat los om de noot toe te voegen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj pięciolinię, wybierz wysokość i puść, aby dodać nutę"

    "%lld개 음표를 받아썼습니다.\n음높이나 길이가 다르면 음표를 끌어서 고쳐 주세요." : {
      "comment" : "Dictation import message; %lld = note count",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld개 음표를 받아썼습니다.\n음높이나 길이가 다르면 음표를 끌어서 고쳐 주세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes transcribed: %lld.\nIf a pitch or length is off, drag the note to fix it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes transcribed: %lld.\nIf a pitch or length is off, drag the note to fix it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已听写音符：%lld。\n如果音高或时值不对，请拖动音符进行修改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已聽寫音符：%lld。\n若音高或長度不對，請拖移音符來修改。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き取った音符：%lld。\n音の高さや長さが違うときは、音符をドラッグして直してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записано нот: %lld.\nЕсли высота или длительность неверны, перетащите ноту, чтобы исправить."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notas dictadas: %lld.\nSi alguna altura o duración no es correcta, arrastra la nota para corregirla."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktierte Noten: %lld.\nStimmt eine Tonhöhe oder Länge nicht, zieh die Note, um sie zu korrigieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes dictées : %lld.\nSi une hauteur ou une durée est fausse, faites glisser la note pour la corriger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note dettate: %lld.\nSe un’altezza o una durata non è giusta, trascina la nota per correggerla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notas ditadas: %lld.\nSe alguma altura ou duração estiver errada, arraste a nota para corrigir."
          }
        }
      }
    },

        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” — không tìm thấy tên nốt trong đó.\nHãy nói 도 레 미 파 솔 라 시."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ – nebyly nalezeny žádné názvy not.\nŘekněte 도 레 미 파 솔 라 시."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” – der blev ikke fundet nogen nodenavne.\nSig 도 레 미 파 솔 라 시."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — δεν βρέθηκαν ονόματα νοτών εδώ.\nΠείτε 도 레 미 파 솔 라 시."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” – nuottien nimiä ei löytynyt.\nSano 도 레 미 파 솔 라 시."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” — tidak ada nama nada yang ditemukan.\nUcapkan 도 레 미 파 솔 라 시."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» – fant ingen notenavn.\nSi 도 레 미 파 솔 라 시."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” – hierin zijn geen nootnamen gevonden.\nZeg 도 레 미 파 솔 라 시."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” – nie znaleziono tu nazw nut.\nPowiedz 도 레 미 파 솔 라 시."
          }
        }

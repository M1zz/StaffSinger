          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Reduce Motion on, screen effects calm down."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“减弱动态效果”后，屏幕效果会更平静。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「減少動態效果」後，畫面效果會更平靜。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

    "4도보다 넓게 뛸 땐 \"높은 솔\", \"낮은 시\"처럼 말하세요" : {
      "comment" : "Tip; Korean words are spoken",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4도보다 넓게 뛸 땐 \"높은 솔\", \"낮은 시\"처럼 말하세요"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For leaps wider than a fourth, say \"높은 솔\" (high sol) or \"낮은 시\" (low si)"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For leaps wider than a fourth, say \"높은 솔\" (high sol) or \"낮은 시\" (low si)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音程跳进超过四度时，请说“높은 솔”（高 sol）或“낮은 시”（低 si）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音程跳進超過四度時，請說「높은 솔」（高 sol）或「낮은 시」（低 si）"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4度より大きく跳ぶときは「높은 솔」（高いソ）や「낮은 시」（低いシ）のように言ってください"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При скачках шире кварты говорите «높은 솔» (высокая соль) или «낮은 시» (низкая си)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En saltos mayores que una cuarta, di «높은 솔» (sol agudo) o «낮은 시» (si grave)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Sprüngen über eine Quarte sag „높은 솔“ (hohes Sol) oder „낮은 시“ (tiefes Si)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un saut supérieur à une quarte, dites « 높은 솔 » (sol aigu) ou « 낮은 시 » (si grave)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per salti più ampi di una quarta, di’ «높은 솔» (sol acuto) o «낮은 시» (si grave)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em saltos maiores que uma quarta, diga “높은 솔” (sol agudo) ou “낮은 시” (si grave)"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าโน้ตกระโดดเกินคู่สี่ ให้พูดว่า “높은 솔” (ซอลสูง) หรือ “낮은 시” (ทีต่ำ)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi nhảy quãng rộng hơn quãng bốn, hãy nói “높은 솔” (sol cao) hoặc “낮은 시” (si thấp)"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U skoků větších než kvarta říkejte „높은 솔“ (vysoké sol) nebo „낮은 시“ (nízké si)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved spring større end en kvart skal du sige “높은 솔” (høj sol) eller “낮은 시” (lav si)"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για πηδήματα μεγαλύτερα από τετάρτη, πείτε «높은 솔» (ψηλό σολ) ή «낮은 시» (χαμηλό σι)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun hyppy on kvarttia suurempi, sano ”높은 솔” (korkea sol) tai ”낮은 시” (matala si)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk lompatan lebih lebar dari kuart, ucapkan “높은 솔” (sol tinggi) atau “낮은 시” (si rendah)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved sprang større enn en kvart sier du «높은 솔» (høy sol) eller «낮은 시» (lav si)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg bij sprongen groter dan een kwart „높은 솔” (hoge sol) of „낮은 시” (lage si)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy skokach większych niż kwarta mów „높은 솔” (wysokie sol) lub „낮은 시” (niskie si)"
          }
        }
      }
    },

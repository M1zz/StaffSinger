        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法识别乐谱。清晰的印刷谱、单行、正面拍摄的照片效果最好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法辨識樂譜。清晰的印刷譜、單行、正面拍攝的照片效果最好。"

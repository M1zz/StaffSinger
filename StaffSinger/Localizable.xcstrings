    "앞 음과 가까운 옥타브를 고릅니다. \"시 도\"가 반음 위로 올라갑니다." : {
      "comment" : "Explanation with Korean syllables in quotes",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞 음과 가까운 옥타브를 고릅니다. \"시 도\"가 반음 위로 올라갑니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picks the octave closest to the previous note, so \"ti do\" rises by a semitone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picks the octave closest to the previous note, so \"ti do\" rises by a semitone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择离前一个音最近的八度，所以“ti do”会上行半音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇最接近前一個音的八度，所以「ti do」會上行半音。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直前の音に近いオクターブを選びます。「ti do」は半音上がります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирает октаву, ближайшую к предыдущей ноте, поэтому «ti do» идёт на полутон вверх."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la octava más cercana a la nota anterior, así «ti do» sube un semitono."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählt die Oktave, die der vorigen Note am nächsten liegt, sodass „ti do“ einen Halbton aufwärts geht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisit l’octave la plus proche de la note précédente : « ti do » monte donc d’un demi-ton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sceglie l’ottava più vicina alla nota precedente, quindi «ti do» sale di un semitono."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe a oitava mais próxima da nota anterior, então \"ti do\" sobe um semitom."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกอ็อกเทฟที่ใกล้กับตัวโน้ตก่อนหน้ามากที่สุด “ti do” จึงขึ้นไปครึ่งเสียง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn quãng tám gần nốt trước nhất, nên \"ti do\" đi lên nửa cung."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybere oktávu nejbližší předchozí notě, takže „ti do“ stoupne o půltón."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælger den oktav, der ligger nærmest den forrige node, så “ti do” går en halvtone op."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέγει την οκτάβα που είναι πιο κοντά στην προηγούμενη νότα, έτσι το «ti do» ανεβαίνει ένα ημιτόνιο."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitsee edellistä nuottia lähimmän oktaavin, joten ”ti do” nousee puolisävelaskeleen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memilih oktaf yang paling dekat dengan not sebelumnya, jadi \"ti do\" naik setengah nada."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velger oktaven nærmest forrige note, så «ti do» går en halvtone opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiest het octaaf dat het dichtst bij de vorige noot ligt, zodat ‘ti do’ een halve toon stijgt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybiera oktawę najbliższą poprzedniej nucie, więc „ti do” idzie o półton w górę."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väljer den oktav som ligger närmast föregående not, så ”ti do” går upp ett halvt tonsteg."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önceki notaya en yakın oktavı seçer; böylece \"ti do\" yarım ses yükselir."
          }
        }
      }
    },

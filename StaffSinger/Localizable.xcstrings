    "악보를 인식하지 못했습니다. 깨끗한 인쇄·한 줄·정면 사진일수록 잘 됩니다." : {
      "comment" : "OMR failure message",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "악보를 인식하지 못했습니다. 깨끗한 인쇄·한 줄·정면 사진일수록 잘 됩니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't read the score. Clean printed music, a single line and a straight-on photo work best."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't read the score. Clean printed music, a single line and a straight-on photo work best."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法识别乐谱。清晰的印刷谱、单行、正面拍摄的照片效果最好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法辨識樂譜。清晰的印刷譜、單行、正面拍攝的照片效果最好。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "譜面を認識できませんでした。きれいな印刷、1段、正面から撮った写真ほどうまくいきます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось распознать ноты. Лучше всего работают чёткая печать, одна строка и снимок прямо перед нотами."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer la partitura. Funciona mejor con música impresa nítida, una sola línea y una foto de frente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Noten konnten nicht gelesen werden. Am besten klappt es mit sauberem Notendruck, einer einzelnen Zeile und einem Foto von vorn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire la partition. Les meilleurs résultats : musique imprimée nette, une seule ligne, photo prise de face."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere lo spartito. Funziona meglio con musica stampata nitida, un solo rigo e una foto frontale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler a partitura. Funciona melhor com música impressa nítida, uma única linha e foto de frente."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านโน้ตไม่สำเร็จ โน้ตพิมพ์ที่คมชัด บรรทัดเดียว และถ่ายตรงด้านหน้าจะได้ผลดีที่สุด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đọc được bản nhạc. Nhạc in rõ nét, một dòng và ảnh chụp thẳng sẽ cho kết quả tốt nhất."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partituru se nepodařilo přečíst. Nejlépe fungují čistý tisk, jedna řádka a fotka přímo zepředu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noderne kunne ikke læses. Det virker bedst med tydeligt trykte noder, én linje og et billede taget forfra."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ανάγνωση της παρτιτούρας. Καλύτερα αποτελέσματα με καθαρή εκτύπωση, μία γραμμή και φωτογραφία από μπροστά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuotteja ei voitu lukea. Parhaiten toimivat selkeä painettu nuotti, yksi rivi ja suoraan edestä otettu kuva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partitur tidak dapat dibaca. Hasil terbaik didapat dari cetakan yang jelas, satu baris, dan foto dari depan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke lese notene. Det fungerer best med tydelig trykte noter, én linje og et bilde tatt rett forfra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De partituur kon niet worden gelezen. Het werkt het best met duidelijk gedrukte muziek, één regel en een foto recht van voren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odczytać partytury. Najlepiej działają czysty druk, jedna linijka i zdjęcie zrobione na wprost."
          }
        }
      }
    },

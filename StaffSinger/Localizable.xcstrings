    "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요." : {
      "comment" : "Roadmap item detail: colors and contrast",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays readable, even with Increase Contrast on or if colors are hard to tell apart."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays readable, even with Increase Contrast on or if colours are hard to tell apart."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使开启“增强对比度”或难以分辨颜色，内容也清晰可读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使開啟「增強對比」或難以分辨顏色，內容依然清楚易讀。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを上げたり、色の区別が難しくても、内容を読み取れます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё остаётся читаемым при повышенной контрастности и при трудностях с различением цветов."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se lee bien, incluso con Aumentar contraste o si cuesta distinguir los colores."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt lesbar, auch mit erhöhtem Kontrast oder wenn Farben schwer zu unterscheiden sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste lisible, même avec Augmenter le contraste ou si les couleurs sont difficiles à distinguer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto resta leggibile, anche con Aumenta contrasto o se è difficile distinguere i colori."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo continua legível, mesmo com Aumentar contraste ou se for difícil distinguir as cores."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกอย่างยังอ่านได้ แม้เปิดเพิ่มคอนทราสต์หรือแยกสีได้ยาก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thứ vẫn dễ đọc, kể cả khi bật Tăng độ tương phản hoặc khó phân biệt màu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše zůstane čitelné i se zvýšeným kontrastem nebo při obtížném rozlišování barev."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt kan stadig læses, også med Øget kontrast eller hvis farver er svære at kende forskel på."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα παραμένουν ευανάγνωστα, ακόμη και με αυξημένη αντίθεση ή όταν τα χρώματα ξεχωρίζουν δύσκολα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki pysyy luettavana, vaikka kontrastia lisättäisiin tai värejä olisi vaikea erottaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semuanya tetap terbaca, bahkan dengan Tingkatkan Kontras atau saat warna sulit dibedakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt er fortsatt lesbart, også med Øk kontrast eller hvis farger er vanskelige å skille."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles blijft leesbaar, ook met Hoger contrast of als kleuren lastig te onderscheiden zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko pozostaje czytelne, także przy zwiększonym kontraście lub gdy trudno odróżnić kolory."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt förblir läsbart, även med Öka kontrast eller om färger är svåra att skilja åt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrastı artırsan veya renkleri ayırt etmekte zorlansan da her şey okunaklı kalır."
          }
        }
      }
    },
    "더 많은 나라 말로 앱을 쓸 수 있게 해요." : {
      "comment" : "Roadmap item detail: more languages",

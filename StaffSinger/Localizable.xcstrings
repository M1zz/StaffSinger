    "4도보다 넓게 뛸 땐 \"높은 솔\", \"낮은 시\"처럼 말하세요" : {
      "comment" : "Tip; Korean words are spoken",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4도보다 넓게 뛸 땐 \"높은 솔\", \"낮은 시\"처럼 말하세요"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For leaps wider than a fourth, say \"high sol\" or \"low ti\""
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For leaps wider than a fourth, say \"high sol\" or \"low ti\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳进超过四度时，请说“high sol”或“low ti”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳進超過四度時，請說「high sol」或「low ti」"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4度より大きく跳ぶときは「high sol」「low ti」のように言ってください"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для скачков шире кварты говорите «high sol» или «low ti»"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para saltos mayores que una cuarta, di «high sol» o «low ti»"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Sprüngen über eine Quarte sag „high sol“ oder „low ti“"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un saut de plus d’une quarte, dites « high sol » ou « low ti »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per salti più ampi di una quarta, di’ «high sol» o «low ti»"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para saltos maiores que uma quarta, diga \"high sol\" ou \"low ti\""
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าโน้ตกระโดดเกินคู่สี่ ให้พูดว่า “high sol” หรือ “low ti”"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi nhảy quãng rộng hơn quãng bốn, hãy nói \"high sol\" hoặc \"low ti\""
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U skoků větších než kvarta říkejte „high sol“ nebo „low ti“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved spring større end en kvart skal du sige “high sol” eller “low ti”"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για πηδήματα μεγαλύτερα από τέταρτη, πείτε «high sol» ή «low ti»"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun hyppy on kvarttia suurempi, sano ”high sol” tai ”low ti”"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk lompatan lebih dari kwart, ucapkan \"high sol\" atau \"low ti\""
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved sprang større enn en kvart sier du «high sol» eller «low ti»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg bij sprongen groter dan een kwart ‘high sol’ of ‘low ti’"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy skokach większych niż kwarta mów „high sol” albo „low ti”"

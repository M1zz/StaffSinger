{
  "sourceLanguage" : "ko",
  "strings" : {
    "\n2마디를 넘는 음표는 화면에 보이지 않을 수 있어요." : {
      "comment" : "Paste overflow warning (starts with newline)",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n2마디를 넘는 음표는 화면에 보이지 않을 수 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNotes beyond the second bar may not be visible."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNotes beyond the second bar may not be visible."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n超过第2小节的音符可能不会显示在屏幕上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n超過第2小節的音符可能不會顯示在畫面上。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n2小節を超える音符は画面に表示されないことがあります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nНоты за пределами второго такта могут не отображаться на экране."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLas notas más allá del segundo compás pueden no verse en pantalla."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNoten hinter dem zweiten Takt sind auf dem Bildschirm eventuell nicht zu sehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLes notes au-delà de la deuxième mesure peuvent ne pas s’afficher à l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLe note oltre la seconda battuta potrebbero non essere visibili sullo schermo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNotas além do segundo compasso podem não aparecer na tela."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nโน้ตที่เกินห้องที่สองอาจไม่แสดงบนหน้าจอ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nCác nốt sau ô nhịp thứ hai có thể không hiện trên màn hình."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNoty za druhým taktem nemusí být na obrazovce vidět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNoder efter anden takt vises muligvis ikke på skærmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nΟι νότες μετά το δεύτερο μέτρο μπορεί να μην εμφανίζονται στην οθόνη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nToisen tahdin jälkeiset nuotit eivät välttämättä näy näytöllä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNot setelah birama kedua mungkin tidak terlihat di layar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNoter etter andre takt vises kanskje ikke på skjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNoten na de tweede maat zijn mogelijk niet zichtbaar op het scherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNuty po drugim takcie mogą nie być widoczne na ekranie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNoter efter andra takten syns kanske inte på skärmen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nİkinci ölçüden sonraki notalar ekranda görünmeyebilir."
          }
        }
      }
    },
    "\"%@\" — 여기서 계이름을 찾지 못했습니다.\n도 레 미 파 솔 라 시 로 말해 주세요." : {
      "comment" : "Dictation error; %@ = what was heard",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" — 여기서 계이름을 찾지 못했습니다.\n도 레 미 파 솔 라 시 로 말해 주세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" — no note names found in that.\nPlease say do re mi fa sol la ti."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" — no note names found in that.\nPlease say do re mi fa sol la ti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”——其中没有找到唱名。\n请用英语说 do re mi fa sol la ti。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」——其中沒有找到唱名。\n請用英語說 do re mi fa sol la ti。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」——ここから階名が見つかりませんでした。\n英語で do re mi fa sol la ti と言ってください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — здесь не найдено названий нот.\nПроизносите по-английски: do re mi fa sol la ti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@»: no se encontraron nombres de notas.\nDi en inglés do re mi fa sol la ti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ – darin wurden keine Notennamen gefunden.\nSprich auf Englisch do re mi fa sol la ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » : aucun nom de note trouvé.\nDites en anglais do re mi fa sol la ti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@»: non sono stati trovati nomi di note.\nPronuncia in inglese do re mi fa sol la ti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\": nenhum nome de nota encontrado.\nDiga em inglês do re mi fa sol la ti."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” — ไม่พบชื่อตัวโน้ตในนี้\nโปรดพูดเป็นภาษาอังกฤษว่า do re mi fa sol la ti"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" — không tìm thấy tên nốt nào.\nHãy đọc bằng tiếng Anh: do re mi fa sol la ti."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ – nebyly nalezeny žádné názvy not.\nŘíkejte anglicky do re mi fa sol la ti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” – der blev ikke fundet nogen nodenavne.\nSig do re mi fa sol la ti på engelsk."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — δεν βρέθηκαν ονόματα νοτών.\nΠείτε στα αγγλικά do re mi fa sol la ti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” – nuottien nimiä ei löytynyt.\nSano englanniksi do re mi fa sol la ti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" — tidak ditemukan nama nada.\nUcapkan dalam bahasa Inggris: do re mi fa sol la ti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» – fant ingen notenavn her.\nSi do re mi fa sol la ti på engelsk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ – hierin zijn geen nootnamen gevonden.\nZeg in het Engels do re mi fa sol la ti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” – nie znaleziono tu nazw nut.\nMów po angielsku: do re mi fa sol la ti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” – inga notnamn hittades.\nSäg do re mi fa sol la ti på engelska."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" — burada nota adı bulunamadı.\nİngilizce olarak do re mi fa sol la ti de."
          }
        }
      }
    },

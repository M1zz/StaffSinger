    "%lld개 음표를 받아썼습니다.\n음높이나 길이가 다르면 음표를 끌어서 고쳐 주세요." : {
      "comment" : "Dictation import message; %lld = note count",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld개 음표를 받아썼습니다.\n음높이나 길이가 다르면 음표를 끌어서 고쳐 주세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes transcribed: %lld.\nIf a pitch or length is off, drag the note to fix it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes transcribed: %lld.\nIf a pitch or length is off, drag the note to fix it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已听写音符：%lld。\n如果音高或时值不对，请拖动音符进行修改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已聽寫音符：%lld。\n若音高或長度不對，請拖移音符來修改。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き取った音符：%lld。\n音の高さや長さが違うときは、音符をドラッグして直してください。"
          }
        }
      }
    },

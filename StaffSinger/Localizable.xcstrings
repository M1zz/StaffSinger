          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't read the score. Clean printed music, a single line and a straight-on photo work best."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't read the score. Clean printed music, a single line and a straight-on photo work best."
          }

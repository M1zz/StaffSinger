    "Siri에게 말하거나 단축어로 바로 실행해요." : {
      "comment" : "Roadmap item detail: Siri and Shortcuts",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jump right in by asking Siri or running a shortcut."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri에게 말하거나 단축어로 바로 실행해요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jump right in by asking Siri or running a shortcut."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对 Siri 说一声，或运行快捷指令，立即开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對 Siri 說一聲，或執行捷徑，立即開始。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siriに話しかけるか、ショートカットで、すぐに始められます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начинайте сразу — голосом через Siri или командой."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza al instante pidiéndoselo a Siri o con un atajo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkt loslegen: per Siri-Sprachbefehl oder Kurzbefehl."

          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรับจังหวะที่พูดให้ตรงกับตำแหน่งโน้ต %@ ที่ใกล้ที่สุด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Căn mỗi thời điểm bạn nói vào vị trí nốt %@ gần nhất."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý vyslovený okamžik zarovná na nejbližší pozici noty %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilpasser hvert udtalt tidspunkt til den nærmeste %@-nodeposition."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ευθυγραμμίζει κάθε στιγμή ομιλίας στην πλησιέστερη θέση νότας %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohdistaa jokaisen sanotun hetken lähimpään %@-nuotin paikkaan."
          }
        },
        "id" : {

    "NSCameraUsageDescription" : {
      "comment" : "Camera permission prompt",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "악보를 촬영해 참고 이미지로 불러오기 위해 카메라를 사용합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger uses the camera to take a photo of a score and load it as a reference image."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger uses the camera to take a photo of a score and load it as a reference image."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger 使用相机拍摄乐谱，并将其作为参考图片载入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger 使用相機拍攝樂譜，並將其載入作為參考圖片。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSingerは、譜面を撮影して参考画像として読み込むためにカメラを使用します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger использует камеру, чтобы сфотографировать ноты и загрузить снимок как опорное изображение."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger usa la cámara para tomar una foto de una partitura y cargarla como imagen de referencia."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger verwendet die Kamera, um ein Foto von Noten aufzunehmen und als Referenzbild zu laden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger utilise l’appareil photo pour photographier une partition et la charger comme image de référence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger usa la fotocamera per scattare una foto di uno spartito e caricarla come immagine di riferimento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O StaffSinger usa a câmera para fotografar uma partitura e carregá-la como imagem de referência."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger ใช้กล้องเพื่อถ่ายภาพโน้ตและโหลดเป็นภาพอ้างอิง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger dùng máy ảnh để chụp ảnh bản nhạc và tải làm ảnh tham chiếu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger používá fotoaparát k vyfocení partitury a jejímu načtení jako referenčního obrázku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger bruger kameraet til at tage et billede af noder og indlæse det som referencebillede."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το StaffSinger χρησιμοποιεί την κάμερα για να τραβήξει φωτογραφία μιας παρτιτούρας και να την φορτώσει ως εικόνα αναφοράς."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger käyttää kameraa nuotin kuvaamiseen ja sen lataamiseen vertailukuvaksi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger menggunakan kamera untuk memotret partitur dan memuatnya sebagai gambar referensi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger bruker kameraet til å ta bilde av noter og laste det inn som referansebilde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger gebruikt de camera om een foto van een partituur te maken en als referentiebeeld te laden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger używa aparatu do zrobienia zdjęcia partytury i wczytania go jako obrazu referencyjnego."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Microphone permission prompt",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계이름을 말하면 오선지에 음표로 옮기기 위해 마이크를 사용합니다. 녹음은 기기 안에서만 처리되고 저장되지 않습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger uses the microphone to turn the note names you say into notes on the staff. Audio is processed on this device only and is never saved."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger uses the microphone to turn the note names you say into notes on the staff. Audio is processed on this device only and is never saved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger 使用麦克风，把你说出的唱名转成五线谱上的音符。录音只在设备上处理，不会保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger 使用麥克風，把你說出的唱名轉成五線譜上的音符。錄音只會在裝置上處理，不會儲存。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSingerは、話した階名を五線上の音符にするためにマイクを使用します。音声は端末内でのみ処理され、保存されません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger использует микрофон, чтобы превращать названные вами ноты в ноты на нотном стане. Звук обрабатывается только на устройстве и не сохраняется."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger usa el micrófono para convertir en notas del pentagrama los nombres de notas que dices. El audio se procesa solo en este dispositivo y nunca se guarda."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger verwendet das Mikrofon, um die von dir gesprochenen Notennamen in Noten auf dem Notensystem umzuwandeln. Das Audio wird nur auf diesem Gerät verarbeitet und nie gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger utilise le micro pour transformer les noms de notes que vous prononcez en notes sur la portée. L’audio est traité uniquement sur cet appareil et n’est jamais enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger usa il microfono per trasformare i nomi delle note che pronunci in note sul pentagramma. L’audio viene elaborato solo su questo dispositivo e non viene mai salvato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O StaffSinger usa o microfone para transformar os nomes de notas que você fala em notas na pauta. O áudio é processado apenas neste dispositivo e nunca é salvo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger ใช้ไมโครโฟนเพื่อเปลี่ยนชื่อตัวโน้ตที่คุณพูดให้เป็นตัวโน้ตบนบรรทัดห้าเส้น เสียงจะประมวลผลบนอุปกรณ์นี้เท่านั้นและจะไม่ถูกบันทึก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger dùng micrô để chuyển tên nốt bạn nói thành nốt trên khuông nhạc. Âm thanh chỉ được xử lý trên thiết bị này và không bao giờ được lưu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger používá mikrofon k převodu názvů not, které řeknete, na noty v notové osnově. Zvuk se zpracovává pouze v tomto zařízení a nikdy se neukládá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger bruger mikrofonen til at omsætte de nodenavne, du siger, til noder på nodelinjerne. Lyden behandles kun på denne enhed og gemmes aldrig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το StaffSinger χρησιμοποιεί το μικρόφωνο για να μετατρέπει τα ονόματα νοτών που λέτε σε νότες στο πεντάγραμμο. Ο ήχος επεξεργάζεται μόνο σε αυτή τη συσκευή και δεν αποθηκεύεται ποτέ."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger käyttää mikrofonia muuttaakseen sanomasi nuottien nimet nuoteiksi nuottiviivastolle. Ääni käsitellään vain tällä laitteella, eikä sitä koskaan tallenneta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger menggunakan mikrofon untuk mengubah nama nada yang kamu ucapkan menjadi not di paranada. Audio hanya diproses di perangkat ini dan tidak pernah disimpan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger bruker mikrofonen til å gjøre notenavnene du sier om til noter på notesystemet. Lyden behandles bare på denne enheten og lagres aldri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger gebruikt de microfoon om de nootnamen die je zegt om te zetten in noten op de notenbalk. Audio wordt alleen op dit apparaat verwerkt en nooit opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger używa mikrofonu, aby zamieniać wypowiadane przez Ciebie nazwy nut na nuty na pięciolinii. Dźwięk jest przetwarzany tylko na tym urządzeniu i nigdy nie jest zapisywany."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Speech recognition permission prompt",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말한 계이름을 음표로 바꾸기 위해 음성 인식을 사용합니다. 인식은 기기 안에서만 이루어집니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger uses speech recognition to turn the note names you say into notes. Recognition happens on this device only."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger uses speech recognition to turn the note names you say into notes. Recognition happens on this device only."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger 使用语音识别，把你说出的唱名转成音符。识别只在设备上进行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger 使用語音辨識，把你說出的唱名轉成音符。辨識只會在裝置上進行。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSingerは、話した階名を音符に変換するために音声認識を使用します。認識は端末内でのみ行われます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger использует распознавание речи, чтобы превращать названные вами ноты в нотные знаки. Распознавание выполняется только на устройстве."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger usa el reconocimiento de voz para convertir en notas los nombres de notas que dices. El reconocimiento se hace solo en este dispositivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger verwendet die Spracherkennung, um die von dir gesprochenen Notennamen in Noten umzuwandeln. Die Erkennung läuft nur auf diesem Gerät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger utilise la reconnaissance vocale pour transformer les noms de notes que vous prononcez en notes. La reconnaissance s’effectue uniquement sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger usa il riconoscimento vocale per trasformare i nomi delle note che pronunci in note. Il riconoscimento avviene solo su questo dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O StaffSinger usa o reconhecimento de voz para transformar os nomes de notas que você fala em notas. O reconhecimento acontece apenas neste dispositivo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger ใช้การรู้จำเสียงเพื่อเปลี่ยนชื่อตัวโน้ตที่คุณพูดให้เป็นตัวโน้ต การรู้จำเสียงทำงานบนอุปกรณ์นี้เท่านั้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger dùng tính năng nhận dạng giọng nói để chuyển tên nốt bạn nói thành nốt nhạc. Việc nhận dạng chỉ diễn ra trên thiết bị này."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger používá rozpoznávání řeči k převodu názvů not, které řeknete, na noty. Rozpoznávání probíhá pouze v tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger bruger talegenkendelse til at omsætte de nodenavne, du siger, til noder. Genkendelsen foregår kun på denne enhed."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το StaffSinger χρησιμοποιεί την αναγνώριση ομιλίας για να μετατρέπει τα ονόματα νοτών που λέτε σε νότες. Η αναγνώριση γίνεται μόνο σε αυτή τη συσκευή."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger käyttää puheentunnistusta muuttaakseen sanomasi nuottien nimet nuoteiksi. Tunnistus tapahtuu vain tällä laitteella."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger menggunakan pengenalan suara untuk mengubah nama nada yang kamu ucapkan menjadi not. Pengenalan hanya berlangsung di perangkat ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger bruker talegjenkjenning til å gjøre notenavnene du sier om til noter. Gjenkjenningen skjer bare på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger gebruikt spraakherkenning om de nootnamen die je zegt om te zetten in noten. De herkenning gebeurt alleen op dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StaffSinger używa rozpoznawania mowy, aby zamieniać wypowiadane przez Ciebie nazwy nut na nuty. Rozpoznawanie odbywa się tylko na tym urządzeniu."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
